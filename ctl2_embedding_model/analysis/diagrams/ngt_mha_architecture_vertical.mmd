flowchart TD
    A["Updated Collide-2V event"] --> B["Top-pT L1 candidate selection"]
    B --> C["100 x 5 L1 tensor<br/>pt, eta, phi, D0, PID"]
    C --> D["Input projection<br/>Linear: features -> ff_dim + ReLU"]

    D --> E["MHA encoder<br/>2 CTL2-style attention blocks"]
    E --> E1["MHA block 1<br/>Q/K/V projections + scaled dot-product attention"]
    E1 --> R1["Residual add"]
    R1 --> E2["MHA block 2<br/>Q/K/V projections + scaled dot-product attention"]
    E2 --> R2["Residual add"]

    R2 --> P{"Pooling"}
    P --> PM["Mean pooling (baseline)<br/>global average over valid candidates"]
    P --> PA["Attention pooling<br/>learned candidate weights"]

    PM --> H["Post-pool dense stack<br/>Linear + ReLU + Linear + ReLU"]
    PA --> H
    H --> Z["Latent embedding<br/>latent_dim = 64 (baseline)<br/>CE + latent_var_reg_weight = 0.01"]

    Z --> CL{"Classifier head"}
    CL --> L["Linear head (baseline)<br/>Linear logits"]
    CL --> M["MLP head<br/>Linear + ReLU + Linear logits"]

    L --> O["Class probabilities<br/>SM superclasses: MinBias, QCD, DY, Top,<br/>W+jets, WW, WZ, ttW, ttZ + HH4B (signal)"]
    M --> O
    Z --> Q["Latent diagnostics<br/>PCA, effective rank, latent Fisher, head Fisher"]
